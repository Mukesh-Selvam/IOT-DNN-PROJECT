# ==========================================
# IoT Accident Detection & Alert System Config
# ==========================================

# Environment
NODE_ENV=development

# Server (Backend)
PORT=5000
MONGODB_URI=mongodb://localhost:27017/iot_accident_detection
MQTT_BROKER_URL=mqtt://localhost:1883
JWT_SECRET=iot_accident_detection_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ML Service Integration
ML_SERVICE_URL=http://localhost:8000
ACCIDENT_CONFIDENCE_THRESHOLD=0.75
PEAK_G_THRESHOLD=4.0
CANCELLATION_WINDOW_SECONDS=15
ALERT_DEBOUNCE_SECONDS=30

# Emergency Notification Services
# Email via Nodemailer (leave empty to use auto-generated Ethereal test credentials)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="IoT Accident Alert System <alerts@iot-accident.local>"

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Simulator Configurations (Virtual ESP32 Fleet)
MQTT_URL=mqtt://localhost:1883
VEHICLE_COUNT=3
SAMPLE_RATE_HZ=50
NOISE_SCALE=1.0
AUTO_EVENTS=true
INCLUDE_GROUND_TRUTH=true
POST_CRASH_HOLD_SEC=20
SEED=
LOCAL_TRIGGER=true
LOCAL_THRESHOLD_G=4.0
CANCEL_WINDOW_SEC=15
COOLDOWN_SEC=30
BUZZER_AUTO_OFF_SEC=60
CONTROL_PORT=5055
CONTROL_API_KEY=
LOG_LEVEL=info

# ML Service Settings
ML_HOST=0.0.0.0
ML_PORT=8000

# Client Vite App
VITE_API_URL=http://localhost:5000
VITE_WS_URL=http://localhost:5000
